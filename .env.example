# Copy to .env.local. Everything is optional for local dev.

# Neon Postgres. Without it, /book shows "Bookings aren't connected yet". Create the table with db/schema.sql.
DATABASE_URL=

# Cloudflare Turnstile (spam protection on /book). Both unset = disabled.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Contact buttons on the landing page; hidden when unset.
NEXT_PUBLIC_MESSENGER_URL=
NEXT_PUBLIC_CONTACT_EMAIL=
